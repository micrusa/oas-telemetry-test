#!/bin/bash

# Configuration
BASE_URL="http://localhost:3000"

# Help function
show_help() {
  echo "Usage: ./test-api.sh [COMMAND] [ARGS...]"
  echo ""
  echo "Commands:"
  echo "  list            List all users (GET /users)"
  echo "  create          Create a new user (POST /users)"
  echo "  get [id]        Get a user by ID (GET /users/:id)"
  echo "  update [id]     Update a user by ID (PUT /users/:id)"
  echo "  delete [id]     Delete a user by ID (DELETE /users/:id)"
  echo "  error           Call endpoint that always fails (GET /error)"
  echo "  slow            Call slow endpoint (GET /slow)"
  echo "  fast            Call fast endpoint (GET /fast)"
  echo "  random          Call endpoint that fails randomly (GET /random-error)"
  echo "  root            Call root endpoint (GET /)"
  echo "  help            Show this help message"
  echo ""
  echo "Examples:"
  echo "  ./test-api.sh create"
  echo "  ./test-api.sh get 1"
}

# Check if command is provided
if [ -z "$1" ]; then
  show_help
  exit 1
fi

case "$1" in
  list)
    curl -i -X GET "$BASE_URL/users"
    ;;
  create)
    curl -i -X POST "$BASE_URL/users" \
      -H "Content-Type: application/json" \
      -d '{"name": "New User", "email": "new@example.com"}'
    ;;
  get)
    if [ -z "$2" ]; then echo "Error: ID required"; exit 1; fi
    curl -i -X GET "$BASE_URL/users/$2"
    ;;
  update)
    if [ -z "$2" ]; then echo "Error: ID required"; exit 1; fi
    curl -i -X PUT "$BASE_URL/users/$2" \
      -H "Content-Type: application/json" \
      -d '{"name": "Updated Name", "email": "updated@example.com"}'
    ;;
  delete)
    if [ -z "$2" ]; then echo "Error: ID required"; exit 1; fi
    curl -i -X DELETE "$BASE_URL/users/$2"
    ;;
  error)
    curl -i -X GET "$BASE_URL/error"
    ;;
  slow)
    echo "This might take a few seconds..."
    curl -i -X GET "$BASE_URL/slow"
    ;;
  fast)
    curl -i -X GET "$BASE_URL/fast"
    ;;
  random)
    curl -i -X GET "$BASE_URL/random-error"
    ;;
  root)
    curl -i -X GET "$BASE_URL/"
    ;;
  help|--help|-h)
    show_help
    ;;
  *)
    echo "Unknown command: $1"
    show_help
    exit 1
    ;;
esac
echo ""
